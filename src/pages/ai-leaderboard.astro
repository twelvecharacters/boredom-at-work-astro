  <!-- Client-side Interactive Filter Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('model-search');
      const filterTabs = document.querySelectorAll('.filter-tab');
      const tableRows = document.querySelectorAll('.model-row');
      const cards = document.querySelectorAll('.model-card');
      const noResults = document.getElementById('no-results');
      const resetBtn = document.getElementById('reset-filters');

      let currentFilter = 'all';
      let currentQuery = '';

      function applyFilters() {
        let visibleCount = 0;

        function checkItem(element) {
          const name = element.dataset.name || '';
          const creator = element.dataset.creator || '';
          const category = element.dataset.category || '';
          const type = element.dataset.type || '';

          const matchesQuery = !currentQuery || 
            name.includes(currentQuery) || 
            creator.includes(currentQuery);

          let matchesCategory = false;
          if (currentFilter === 'all') {
            matchesCategory = true;
          } else if (currentFilter === 'open') {
            matchesCategory = (type === 'open');
          } else {
            matchesCategory = (category === currentFilter);
          }

          const isVisible = matchesQuery && matchesCategory;
          element.style.display = isVisible ? '' : 'none';
          return isVisible;
        }

        tableRows.forEach(row => {
          if (checkItem(row)) visibleCount++;
        });

        cards.forEach(card => {
          checkItem(card);
        });

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      filterTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          filterTabs.forEach(t => {
            t.classList.remove('bg-primary', 'text-white');
            t.classList.add('bg-background-alt', 'text-text-light');
          });
          tab.classList.remove('bg-background-alt', 'text-text-light');
          tab.classList.add('bg-primary', 'text-white');

          currentFilter = tab.dataset.filter;
          applyFilters();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = e.target.value.trim().toLowerCase();
          applyFilters();
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          currentQuery = '';
          currentFilter = 'all';
          filterTabs.forEach(t => {
            t.classList.remove('bg-primary', 'text-white');
            t.classList.add('bg-background-alt', 'text-text-light');
            if (t.dataset.filter === 'all') {
              t.classList.remove('bg-background-alt', 'text-text-light');
              t.classList.add('bg-primary', 'text-white');
            }
          });
          applyFilters();
        });
      }
    });
  </script>
