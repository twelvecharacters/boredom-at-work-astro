---
---

<div
  id="cookie-banner"
  class="fixed bottom-4 left-4 right-4 md:left-auto md:right-4 md:max-w-md bg-white/95 backdrop-blur-md border border-slate-200/80 rounded-2xl p-4 shadow-xl z-50 transform translate-y-full opacity-0 transition-all duration-300 pointer-events-none"
  role="region"
  aria-label="Cookie Notice"
>
  <div class="flex items-start gap-3 text-slate-800">
    <div class="mt-0.5 text-accent flex-shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
        <path d="M8.5 8.5v.01"/>
        <path d="M16 15.5v.01"/>
        <path d="M12 12v.01"/>
        <path d="M11 17v.01"/>
        <path d="M7 14v.01"/>
      </svg>
    </div>
    
    <div class="flex-1 pr-6">
      <p class="text-xs text-slate-600 leading-relaxed">
        This website uses cookies to analyze traffic and optimize your browsing experience. By continuing to use the site, you agree to our use of cookies.
        <a href="/privacy-policy/" class="underline text-accent hover:text-accent-hover transition-colors font-medium whitespace-nowrap">Privacy Policy</a>.
      </p>
    </div>

    <!-- Close button in the top corner -->
    <button
      id="cookie-close"
      aria-label="Close notice"
      class="absolute top-3 right-3 text-slate-400 hover:text-slate-600 p-1 rounded-lg transition-colors cursor-pointer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="mt-3 flex justify-end">
    <button
      id="cookie-dismiss"
      class="bg-accent hover:bg-accent-hover text-white text-xs font-semibold px-4 py-1.5 rounded-lg transition-colors cursor-pointer shadow-sm"
    >
      Got it
    </button>
  </div>
</div>

<script is:inline>
  (function() {
    function initCookieBanner() {
      var banner = document.getElementById('cookie-banner');
      var dismissBtn = document.getElementById('cookie-dismiss');
      var closeBtn = document.getElementById('cookie-close');

      if (!banner) return;

      var dismissed = false;
      try {
        dismissed = localStorage.getItem('cookie_notice_dismissed') === 'true' || localStorage.getItem('cookie_consent') === 'granted';
        localStorage.setItem('cookie_consent', 'granted');
      } catch (e) {}

      // Show banner notice if not yet dismissed
      if (!dismissed) {
        setTimeout(function() {
          banner.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
        }, 800);
      }

      function dismissNotice() {
        try {
          localStorage.setItem('cookie_notice_dismissed', 'true');
          localStorage.setItem('cookie_consent', 'granted');
        } catch (e) {}

        // Update Google Consent Mode if needed
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push([
          'consent',
          'update',
          {
            'analytics_storage': 'granted'
          }
        ]);

        if (typeof window.gtag === 'function') {
          window.gtag('consent', 'update', {
            'analytics_storage': 'granted'
          });
        }

        // Hide banner smoothly
        banner.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
      }

      if (dismissBtn) {
        dismissBtn.addEventListener('click', dismissNotice);
      }
      if (closeBtn) {
        closeBtn.addEventListener('click', dismissNotice);
      }

      // Global window method to reopen notice (e.g. from footer)
      window.openCookieBanner = function() {
        banner.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
      };
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCookieBanner);
    } else {
      initCookieBanner();
    }
  })();
</script>
