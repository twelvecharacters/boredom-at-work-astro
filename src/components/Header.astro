---
import OptimizedImage from './OptimizedImage.astro';
import Search from './Search.astro';
import logo from '../assets/images/logo.webp';
import { NAV_ITEMS, SITE, type NavItem } from '../config';

const navItems: NavItem[] = NAV_ITEMS;
const currentPath = Astro.url.pathname;
---

<header class="bg-gradient-to-r from-primary to-primary-light sticky top-0 z-50 transition-colors duration-500 shadow-lg">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex justify-between items-center py-3">
      <!-- Logo -->
      <a href="/" class="flex items-center group flex-shrink-0" aria-label="Boredom at Work Home">
        <OptimizedImage
          src={logo}
          alt={SITE.title}
          class="h-11 md:h-13 w-auto transition-transform group-hover:scale-105"
          width={296}
          height={95}
          loading="eager"
          fetchpriority="high"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-7">
        {navItems.map(item => {
          if (item.children && item.children.length > 0) {
            const isChildActive = item.children.some(c => currentPath === c.href);
            return (
              <div class="relative group/dropdown py-2">
                <a
                  href={item.href}
                  class:list={[
                    "flex items-center gap-1.5 text-sm font-medium transition-colors text-white/90 hover:text-white group-hover/dropdown:text-white",
                    { "text-white font-bold": isChildActive || currentPath === item.href }
                  ]}
                >
                  <span>{item.label}</span>
                  <svg
                    class="w-3.5 h-3.5 text-white/60 group-hover/dropdown:rotate-180 group-hover/dropdown:text-white transition-transform duration-200"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>

                <!-- Hover Bridge & Dropdown Card -->
                <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 w-80 opacity-0 pointer-events-none group-hover/dropdown:opacity-100 group-hover/dropdown:pointer-events-auto transition-all duration-200 z-50">
                  <div class="bg-primary/95 backdrop-blur-xl border border-white/10 rounded-2xl p-2.5 shadow-2xl space-y-1">
                    {item.children.map(child => (
                      <a
                        href={child.href}
                        class:list={[
                          "flex items-start gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item",
                          { "bg-white/10": currentPath === child.href }
                        ]}
                      >
                        {child.icon && (
                          <span class="text-xl flex-shrink-0 mt-0.5 group-hover/item:scale-110 transition-transform">
                            {child.icon}
                          </span>
                        )}
                        <div class="min-w-0">
                          <div class="text-xs font-bold text-white group-hover/item:text-accent transition-colors">
                            {child.label}
                          </div>
                          {child.description && (
                            <div class="text-[11px] text-white/60 line-clamp-1 mt-0.5">
                              {child.description}
                            </div>
                          )}
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          }

          const isActive = currentPath === item.href;
          return (
            <a
              href={item.href}
              class:list={[
                "text-sm font-medium transition-colors relative py-2",
                isActive ? "text-white font-bold" : "text-white/90 hover:text-white"
              ]}
            >
              <span>{item.label}</span>
              {isActive && (
                <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-accent rounded-full"></span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- Right side: Search + Mobile Menu Button -->
      <div class="flex items-center gap-3">
        <!-- Search bar -->
        <Search />

        <!-- Mobile Menu Button -->
        <button
          id="menu-toggle"
          class="md:hidden p-2 text-white hover:bg-white/10 rounded-lg transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <nav
      id="mobile-menu"
      class="hidden md:hidden absolute right-4 left-4 top-full mt-2 bg-primary/95 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl p-4 max-h-[80vh] overflow-y-auto"
    >
      <div class="flex flex-col gap-1.5">
        {navItems.map(item => {
          if (item.children && item.children.length > 0) {
            return (
              <div class="py-2 border-y border-white/10 my-1">
                <div class="text-[11px] font-extrabold uppercase tracking-wider text-white/50 px-3 mb-2">
                  Master Playbooks & Guides
                </div>
                <div class="grid grid-cols-1 gap-1">
                  {item.children.map(child => (
                    <a
                      href={child.href}
                      class:list={[
                        "flex items-center gap-3 px-3 py-2 rounded-xl text-white font-medium hover:bg-white/10 transition-colors text-sm",
                        { "bg-white/10 font-bold": currentPath === child.href }
                      ]}
                    >
                      {child.icon && <span>{child.icon}</span>}
                      <span>{child.label}</span>
                    </a>
                  ))}
                </div>
              </div>
            );
          }

          return (
            <a
              href={item.href}
              class:list={[
                "flex items-center justify-between px-3 py-2.5 text-white font-medium rounded-xl hover:bg-white/10 transition-colors text-sm",
                { "bg-white/10 font-bold": currentPath === item.href }
              ]}
            >
              <span>{item.label}</span>
            </a>
          );
        })}
      </div>
    </nav>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  menuToggle?.addEventListener('click', () => {
    const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';

    menuToggle.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    if (!menuToggle?.contains(e.target as Node) && !mobileMenu?.contains(e.target as Node)) {
      mobileMenu?.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      menuToggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
