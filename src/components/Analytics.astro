<script type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=GT-PL3RVFQX`}></script>
<script type="text/partytown">
  window.dataLayer = window.dataLayer || [];
  window.gtag = function gtag(){dataLayer.push(arguments);}

  // Google Consent Mode v2 - Default to GRANTED unless explicitly denied
  var savedConsent = typeof localStorage !== 'undefined' ? localStorage.getItem('cookie_consent') : null;
  var consentState = savedConsent === 'denied' ? 'denied' : 'granted';

  gtag('consent', 'default', {
    'analytics_storage': consentState,
    'ad_storage': 'denied',
    'ad_user_data': 'denied',
    'ad_personalization': 'denied',
    'wait_for_update': 500
  });

  gtag('js', new Date());
  gtag('config', 'GT-PL3RVFQX');

  // 1. Scroll depth tracking (25/50/75/100%)
  var scrollMarks = [25, 50, 75, 100];
  var firedMarks = {};
  window.addEventListener('scroll', function() {
    var scrollPct = Math.round(100 * (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight);
    for (var i = 0; i < scrollMarks.length; i++) {
      if (scrollPct >= scrollMarks[i] && !firedMarks[scrollMarks[i]]) {
        firedMarks[scrollMarks[i]] = true;
        gtag('event', 'scroll', { percent_scrolled: scrollMarks[i] });
      }
    }
  }, { passive: true });

  // 2. Enhanced Outbound & Affiliate link click tracking
  var AFFILIATE_DOMAINS = ['amazon.com', 'amzn.to', 'justway.com', 'tradingview.com', 'webull.com', 'etoro.com', 'coursera.org', 'bambulab.com', 'anycubic.com'];
  document.addEventListener('click', function(e) {
    var link = e.target.closest('a[href]');
    if (!link) return;
    var href = link.getAttribute('href');
    if (!href) return;

    // Check for internal Pillar Callout clicks
    if (href.startsWith('/') && link.closest('blockquote')) {
      var isPillarLink = href.includes('-guide') || href.includes('travel-planning');
      if (isPillarLink) {
        gtag('event', 'pillar_callout_click', {
          destination_url: href,
          source_path: window.location.pathname
        });
      }
    }

    // Check for external / affiliate links
    if (href.startsWith('http') && !href.includes('boredom-at-work.com')) {
      try {
        var urlObj = new URL(href);
        var hostname = urlObj.hostname.replace(/^www\./, '');
        
        var isAffiliate = AFFILIATE_DOMAINS.some(function(d) { return hostname.includes(d); });
        if (isAffiliate) {
          gtag('event', 'affiliate_click', {
            partner: hostname,
            link_url: href,
            source_path: window.location.pathname
          });
        }

        gtag('event', 'outbound_click', {
          link_url: href,
          link_domain: hostname
        });
      } catch(err) {
        gtag('event', 'outbound_click', { link_url: href });
      }
    }
  });

  // 3. Code & Prompt Copy tracking
  document.addEventListener('click', function(e) {
    var copyBtn = e.target.closest('.expressive-code button, [data-copy-button]');
    if (copyBtn) {
      gtag('event', 'copy_code_snippet', {
        page_path: window.location.pathname
      });
    }
  });

  // 4. Form Submission tracking
  document.addEventListener('submit', function(e) {
    if (e.target.tagName === 'FORM') {
      gtag('event', 'form_submit', {
        form_id: e.target.id || 'unknown',
        form_destination: e.target.action || 'unknown'
      });
    }
  });

  // 5. Search Term tracking (URL query param)
  var urlParams = new URLSearchParams(window.location.search);
  if (urlParams.has('q')) {
    gtag('event', 'view_search_results', { search_term: urlParams.get('q') });
  }

  // 6. Active Reading Completion (User stays >= 60s and scrolls >= 75%)
  var startTime = Date.now();
  var readCompleted = false;
  window.addEventListener('scroll', function() {
    if (readCompleted) return;
    var scrollPct = Math.round(100 * (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight);
    var timeElapsed = (Date.now() - startTime) / 1000;
    if (scrollPct >= 75 && timeElapsed >= 60) {
      readCompleted = true;
      gtag('event', 'article_read_complete', {
        page_path: window.location.pathname,
        time_spent_seconds: Math.round(timeElapsed)
      });
    }
  }, { passive: true });

  // 7. Time-on-Page / Engagement Heartbeat (every 30 seconds)
  setInterval(function() {
    if (document.visibilityState === 'visible') {
      gtag('event', 'engagement_heartbeat', { duration_seconds: 30 });
    }
  }, 30000);
</script>
